# 复制为 keystore.properties 并填入自己的签名信息（keystore.properties 已 gitignore）
#
# 生成 keystore：
#   keytool -genkeypair -v -keystore release.jks -alias juwp \
#     -keyalg RSA -keysize 2048 -validity 10950 \
#     -dname "CN=YourName, OU=JUWP-Schedule, O=YourOrg, C=CN"
#
# 不配置本文件时，release 构建会自动回退 debug 签名（仅可用于本地调试，不可对外分发）

storeFile=release.jks
storePassword=
keyAlias=juwp
keyPassword=
