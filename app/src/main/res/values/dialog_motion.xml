<?xml version="1.0" encoding="utf-8"?>
<!-- 弹窗窗口进出场动画的唯一出处（窗口层 windowAnimations）。
     material3 1.3.0 的 AlertDialog 没有 compose 侧动画、compose 的 DialogWindowTheme
     也没配 windowAnimationStyle，弹窗开关都是瞬间出现/抽掉；由
     ui/common/DialogWindowFade.kt 在运行时把这份样式挂到 dialog window 上。 -->
<resources>
    <style name="DialogWindowFade">
        <item name="android:windowEnterAnimation">@anim/dialog_fade_in</item>
        <item name="android:windowExitAnimation">@anim/dialog_fade_out</item>
    </style>
</resources>
