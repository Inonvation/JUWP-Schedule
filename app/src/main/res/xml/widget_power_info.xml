<?xml version="1.0" encoding="utf-8"?>
<!--
  寝室电费小组件（DESIGN §3.6 三条目改版，2026-09-27）：剩余电度 + 折合金额，
  点击进用电统计。渲染路径零网络（数据 = Room power_readings 最新一条的本地镜像）。

  按**内容**拆条目（课表 / 校园卡 / 电费各一条 receiver），不是按尺寸拆；本条目自身
  仍是单条目 + SizeMode.Exact。内容形态固定，maxResize 收在 4×2，理由同 widget_campus_info。
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:maxResizeWidth="250dp"
    android:maxResizeHeight="110dp"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:updatePeriodMillis="0"
    android:description="@string/widget_power_description"
    android:previewImage="@mipmap/ic_launcher"
    android:initialLayout="@layout/glance_default_loading_layout" />
