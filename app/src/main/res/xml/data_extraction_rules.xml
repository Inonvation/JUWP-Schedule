<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 备份/迁移规则：与 backup_rules.xml 同语义，排除胖乖 token。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_token.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_token.xml" />
    </device-transfer>
</data-extraction-rules>
