<?xml version="1.0" encoding="utf-8"?>
<!--
    备份排除：胖乖登录凭证（secure_token.xml）与校园卡凭证（ykt_credentials.xml，
    DESIGN §4.19）不许进云备份/设备迁移，其余（Room 课表、DataStore 偏好）保持默认可备份。
    jw_credentials.xml 的排除保留（调课自动检测已移除）：老版本升级用户设备上该文件还在，
    删掉排除会让残留凭证被备份走；文件本体不清（App 无权也不必动用户数据）。
-->
<full-backup-content>
    <exclude domain="sharedpref" path="secure_token.xml" />
    <exclude domain="sharedpref" path="jw_credentials.xml" />
    <exclude domain="sharedpref" path="ykt_credentials.xml" />
</full-backup-content>
