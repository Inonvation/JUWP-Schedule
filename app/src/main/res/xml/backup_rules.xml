<?xml version="1.0" encoding="utf-8"?>
<!--
    备份排除：凭据/令牌不许进云备份与设备迁移——
      secure_token.xml    胖乖登录凭证（DESIGN §4.10）
      ykt_credentials.xml 校园卡凭证（学号 + 查询密码，§4.19）
      jw_credentials.xml  统一认证凭证（学号 + 密码，§4.27）
      ykt_tokens.xml      一卡通 access token 落盘缓存（§4.27）
      secure_qzxy.xml     趣智校园登录会话（§4.30）
      secure_kqcx.xml     快趣出行账号凭证（手机号 + 密码，§4.32）
      secure_ujing.xml    U净（美的校园洗衣）登录会话（§4.36）
    其余（Room 课表、DataStore 偏好）保持默认可备份。
    说明：jw_credentials.xml 的排除原先是为已移除的调课检测留的，2026-09-24 起这个文件
    重新被用作 CAS 凭证存储（§4.27），排除项因此继续有效。
-->
<full-backup-content>
    <exclude domain="sharedpref" path="secure_token.xml" />
    <exclude domain="sharedpref" path="secure_qzxy.xml" />
    <exclude domain="sharedpref" path="jw_credentials.xml" />
    <exclude domain="sharedpref" path="ykt_credentials.xml" />
    <exclude domain="sharedpref" path="ykt_tokens.xml" />
    <exclude domain="sharedpref" path="secure_kqcx.xml" />
    <exclude domain="sharedpref" path="secure_ujing.xml" />
</full-backup-content>
