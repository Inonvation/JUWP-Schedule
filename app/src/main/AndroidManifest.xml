<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 教务导入失败时探测是否经由 VPN/代理出网（学校对代理出口区别对待，见 JwVpnDetector） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 附近单车地图「定位到我的位置」（DESIGN §3.9）：只在该按钮被点击时才运行时申请，
         不预取、不参与进页流程。精确档用于把地图中心落到用户所在的那一片车桩，
         用户只给「大致位置」也能用（BikeLocator 两个权限任一即可）。 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- 趣智校园开热水（DESIGN §4.30）：扫描附近的 KLCXKJ 热水器广播，再按地址连设备。
         API 31+ 走新的蓝牙运行时权限（scan 声明 neverForLocation，扫描结果不当定位用）；
         30 及以下系统规定扫描必须持定位权限，那条已为地图声明，这里补两个老权限兜底。
         只在用户进趣智校园页点「扫描设备」时申请，不预取、不进首启流程。 -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- 课表一键同步到系统日历（DESIGN §4.12）：删写本 App 标记事件 + 20 分钟提醒。
         只在用户点「同步到日历」时运行时申请，不预取 -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- 桌面小组件（DESIGN §3.6）：请求忽略电池优化，让后台刷新更及时。
         **可选权限**——用户拒绝后小组件仍可用，只是刷新可能延迟几分钟。
         只在设置页里由用户主动点击申请，不预取、不进首页流程。 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 上课提醒（DESIGN §3.7）：API 33+ 运行时权限，只在用户开启提醒开关那一刻申请 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 免费时长提醒的震动（DESIGN §3.9）：普通权限，安装即授予。
         **Android 8 起通知渠道上的 `vibrationPattern` 要靠它才生效**，缺了系统静默丢弃
         ——2026-09-30 用户报「通知了但没有震动」的根因就是一直没声明这一条
         （渠道里 `enableVibration(true)` 配了也发不出去）。 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 重启后闹钟全部丢失：开机广播补排下一个提醒 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 共享单车免费时长常驻倒计时（DESIGN §3.9，2026-09-24）：前台服务。
         类型选 specialUse —— 它不属于任何一种既有分类（不是同步、不是播放、不是定位），
         且不受 Android 15 对 dataSync/mediaProcessing 的 6 小时限制；
         shortService 只有 3 分钟，装不下 15 分钟的倒计时。
         FOREGROUND_SERVICE_SPECIAL_USE 是普通权限（安装即授予），无运行时申请。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 共享单车出码自动保存（DESIGN §3.9）：API 29+ 走 MediaStore 免权限；
         仅 26–28 的 legacy 公共目录直写需要，且 maxSdkVersion 限定，29 起失效 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- 快趣相机扫一扫（2026-09-29「车号识别联动」）：扫车身二维码识别车号。
         运行时权限由扫码库的 CaptureManager 在进页时自行申请（`EbikeScanActivity` 只转发
         申请结果），这里只声明；设备无补光灯时取景页不摆手电筒按钮 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 今日页快捷方式（DESIGN §4.16）：API 30+ 包可见性声明。
         三个 package 让预设包可见（getLaunchIntentForPackage 不再对已安装的 App
         误报「未安装」）；MAIN/LAUNCHER 让所有有桌面入口的 App 可见——既是编辑表单
         「从已安装应用选择」的数据源，也让自定义「只填包名」的快捷方式能拉起。
         仍不可见的（无桌面入口的应用）靠执行层 try/catch 兜底。 -->
    <queries>
        <package android:name="com.xunmeng.pinduoduo" />
        <package android:name="com.taobao.taobao" />
        <package android:name="com.cainiao.wireless" />
        <!-- 共享单车页（DESIGN §3.9）：「打开微信扫一扫」按钮 best-effort 拉起微信，
             需包可见性做 resolve 探测（不可见时按钮直接给手动扫码引导） -->
        <package android:name="com.tencent.mm" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="pinduoduo" />
        </intent>
        <!-- 趣智校园页「充值」（DESIGN §3.18）：充值落在支付宝的趣智校园小程序，
             拉起 alipays:// 要先能被解析到，否则 startActivity 直接抛
             ActivityNotFoundException（Android 11+ 包可见性过滤）。 -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="alipays" />
        </intent>
        <!-- U净 支付（DESIGN §4.37 P2）：支付宝 SDK 拉起收银台走同一 scheme；
             上面那条 queries 已覆盖，SDK 检测支付宝安装用包名——补一条声明防误判 -->
        <package android:name="com.eg.android.AlipayGphone" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- 定位是可选能力的可选依赖：不声明 required=false 的话，应用商店会把
         「需要 GPS 硬件」当成硬条件，把没有 GPS 模块的设备过滤掉 -->
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <!-- 相机扫一扫（2026-09-29）：同样可选（平板 / 没有摄像头的设备仍可手输车号） -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- 预测性返回（DESIGN §3.1）。targetSdk 34+ 本来就默认启用，这里显式写出来是为了
         表明意图：返回手势交给系统的 OnBackInvokedCallback，二级页的跟手预览才生效
         （过渡动画由 WindowTransitions.kt 声明）。写成 false 会连带关掉手势预览，别改。 -->
    <application
        android:name=".JuwApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.JuwSchedule"
        android:usesCleartextTraffic="true">
        <!-- 根 Activity 的启动姿势（2026-09-23 真机定了三轮，别再改回去）：

             桌面图标点击带的是 NEW_TASK|RESET_TASK_IF_NEEDED。实测四种组合：
             - 默认（standard）：系统在栈顶**新压一个 MainActivity**，底下还压着刚才的
               二级页——用户看到「今日页」，按返回又能退回二级页，观感是导航乱了；
             - alwaysRetainTaskState="true"：同上，拦不住（它只管 task 超时被 reset 那条路）；
             - launchMode="singleTask"：不重复压实例，但 clearTop 会**销毁二级页**，
               回来只能落到根页，用户抱怨「明明在看付款码，回来变成今日页」；
             - singleTask + alwaysRetainTaskState：仍然 clearTop（真机验过）。

             现行解 = 保持 standard + alwaysRetainTaskState，由 MainActivity.onCreate
             那条「不是 task 根就 finish 自己」兜住（见 MainActivity 的 KDoc）：
             多余的实例根本没上屏就关掉了，下面那套窗口原样露出，二级页不会被销毁、
             状态不丢。alwaysRetainTaskState 留着的用处是挡系统 30 分钟的 task reset
             （否则挂后台半小时回来，二级页还是会被系统清掉，这条挡得住）。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:alwaysRetainTaskState="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.JuwSchedule">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 教务导入独立窗口：adjustResize 保证登录表单不被键盘遮住。
             锁竖屏（DESIGN §4.4）：转屏会销毁 WebView 丢掉登录进度、并取消导入协程。
             App 里锁方向的窗口只有这一个和下面的成绩单导出窗口，两者都因为同一个原因
             （窗口里有统一认证的 WebView 表单）。 -->
        <activity
            android:name=".JwImportActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <!-- 成绩单导出独立窗口（DESIGN §3.14）：同样含统一认证 WebView，故同样锁竖屏 -->
        <activity
            android:name=".TranscriptActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <!-- 学工表单独立窗口（DESIGN §3.15）：宿舍报修、请假等共用这一个（表单标识走
             extra）。第三个「因为窗口里有统一认证表单而锁竖屏」的窗口，理由与上面两个
             相同。 -->
        <activity
            android:name=".XgFormActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <!-- 农行支付收银台独立窗口（DESIGN §4.24「农行支付」）：窗口里是农行的支付页面
             （卡号 / 手机号 / 短信验证码 / 支付密码都在那边输入），同样锁竖屏 + adjustResize，
             理由与上面几个含网页表单的窗口相同。 -->
        <activity
            android:name=".PowerBankPayActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <!-- 首次配置引导窗口（DESIGN §3.16）：由 MainActivity 在首启时拉起，
             同样含统一认证表单，故同样锁竖屏。 -->
        <activity
            android:name=".OnboardingActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <!-- 设置类二级页统一独立窗口（课表管理/课表设置/数据/开水等，不含显示设置——
             它是课表页内覆盖面板，见 DESIGN §3.1），底栏不可达，避免子页与 tab 栈混用 -->
        <activity
            android:name=".SubpageActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 课表小组件（DESIGN §3.6）：**单条目**（2026-09-20 起），尺寸自适应。
             旧的按尺寸拆的三条 receiver（Small/Wide/Large）已删——条目名变化会让桌面上
             旧实例失效，用户重新添加一次即可。
             2026-09-27 起另有「校园卡 + 电费」一条（见下），与本条互不相干。
             exported=false：系统按 AppWidget 机制拉起，不需要对外暴露。 -->
        <receiver
            android:name=".ui.widget.ScheduleWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- 开机补排边界闹钟：重启后 AlarmManager 的闹钟全丢，WorkManager
                     周期兜底最长要 15 分钟才拉起进程，期间小组件不按上下课时刻换。
                     RECEIVE_BOOT_COMPLETED 权限已为上课提醒声明，这里无需新增。 -->
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- 生活小组件（DESIGN §3.6 二条目改版，2026-09-27）：校园卡余额 + 寝室电费
             合成一条（余额大字 + 电费副行，点击分区：整卡 → 付款码页、电费行 → 用电统计页）。
             当天先从一条拆成三条、再合并回一条：拆开后 2 格宽的卡片只放得下一块信息。
             receiver 保留 CampusCardWidget 类名，桌面上已添加的校园卡实例平滑变成合并卡；
             原 PowerWidgetReceiver 已删（电费条目并进来，桌面上若有它的实例需手动删掉）。
             渲染路径零网络：校园卡余额由 App 内取数链路顺手推送（2 小时闸门在
             LifeWidgetSync），电费只镜像 Room 最新读数。
             exported=false：系统按 AppWidget 机制拉起，不需要对外暴露。 -->
        <receiver
            android:name=".ui.widget.CampusCardWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_campus_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_campus_info" />
        </receiver>

        <!-- 开水两卡小组件（DESIGN §3.6「开水两卡」，2026-09-28）：胖乖开水 + 趣智开水，
             都**固定 2×2**（provider XML resizeMode="none"，不给拖动），整卡点击各自进
             开水页 / 趣智校园页。渲染路径零网络：余额由页面取数链路顺手推送（2 小时
             闸门在 WaterWidgetSync），趣智「用水中」是本地记账镜像。
             exported=false：系统按 AppWidget 机制拉起，不需要对外暴露。 -->
        <receiver
            android:name=".ui.widget.QiekjWaterWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_water_qiekj_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_water_qiekj" />
        </receiver>
        <receiver
            android:name=".ui.widget.QzxyWaterWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_water_qzxy_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_water_qzxy" />
        </receiver>

        <!-- 小组件边界闹钟落点（上下课时刻刷新），仅内部广播 -->
        <receiver
            android:name=".ui.widget.WidgetBoundaryReceiver"
            android:exported="false" />

        <!-- 上课提醒（DESIGN §3.7）：边界闹钟落点（显式 PendingIntent，无需 intent-filter）
             与开机补排。两者都只把核对排进 WorkManager，不阻塞主线程。 -->
        <receiver
            android:name=".ui.reminder.ReminderAlarmReceiver"
            android:exported="false" />
        <receiver
            android:name=".ui.reminder.ReminderBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 选课轮次提醒（DESIGN §4.35）：边界闹钟落点（显式 PendingIntent，无需
             intent-filter）——只把核对排进 WorkManager，不阻塞主线程 -->
        <receiver
            android:name=".ui.reminder.SelectionAlertReceiver"
            android:exported="false" />

        <!-- 洗衣完成提醒（DESIGN §4.37）：U净 订单洗涤中的精确闹钟落点——到点查一次
             订单详情，已完成发「衣服洗好了」，还在跑按新剩余时间重排 -->
        <receiver
            android:name=".ui.reminder.UjingDoneReceiver"
            android:exported="false" />

        <!-- 抢课会话（DESIGN §4.36，2026-10-01 规划）：前台服务，只在用户显式开始后存在，
             结束时自停。specialUse 的 use case 必须写在 <property> 里（系统按它审核用途）。 -->
        <service
            android:name=".ui.selection.SelectionGrabService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="选课抢课会话：按用户预设清单轮询选课并提交，期间在通知栏显示进度并可一键停止" />
        </service>

        <!-- 免费时长常驻倒计时（DESIGN §3.9，2026-09-24）：前台服务，只在「开关开 + 计时中」
             这 15 分钟里存在。倒计时数字由系统 chronometer 渲染，服务本身不周期干活。
             specialUse 的 use case 必须写在 <property> 里（系统按它审核用途）。 -->
        <service
            android:name=".ui.ebike.EbikeFreeRideService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="共享单车免费时长倒计时：在通知栏常驻显示免费剩余时间，超时前提醒用户还车" />
        </service>

        <!-- 免费时长提醒的精确闹钟落点（显式 PendingIntent，无需 intent-filter）：
             只把核对排进协程，发提醒并重排下一个闹钟 -->
        <receiver
            android:name=".ui.ebike.EbikeFreeRideAlarmReceiver"
            android:exported="false" />

        <!-- 内置相机扫一扫（快趣账号方式的「扫车身码」，DESIGN §3.9）。
             2026-09-30 起换成自己的窗口（`EbikeScanActivity`）——库自带的 CaptureActivity
             只有取景框 + 一行提示，没有开关手电筒与「从相册选图」两个入口，而这两件正是
             暗光 / 码已在相册里时的唯一出路。相机预览 / 权限 / 解码仍由库的
             DecoratedBarcodeView + CaptureManager 承担，故主题沿用库的取景主题。
             锁竖屏（与其它窗口同一理由：扫码时转屏会销毁重建相机预览）。 -->
        <activity
            android:name=".ui.ebike.EbikeScanActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:theme="@style/zxing_CaptureTheme"
            android:windowSoftInputMode="stateAlwaysHidden" />

        <!-- 导出成绩单的分享/打开通道（DESIGN §4.25）：成绩单落在应用私有目录，
             系统 PDF 阅读器与分享目标靠临时授权的内容 Uri 读取，不写公共目录、不申请存储权限。
             authority 带 applicationId 后缀 —— debug 包的包名带 .debug，两者互不影响。
             暴露范围只开 transcripts/（见 res/xml/file_paths.xml）。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
